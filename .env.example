# MongoDB Atlas Credentials
MONGODB_USERNAME=your_mongodb_username
MONGODB_PASSWORD=your_mongodb_password
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/osint_eip?retryWrites=true&w=majority

# Vector Store
CHROMADB_PATH=./chroma_data

# Omniroute (LLM Summarization & Assistant)
OMNIROUTE_API_KEY=your_key_here
OMNIROUTE_BASE_URL=https://api.omniroute.example/v1
OMNIROUTE_TIMEOUT_SECONDS=7

# Ingestion / RSS
SOURCE_REQUEST_TIMEOUT_SECONDS=15
