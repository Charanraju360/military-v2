# MongoDB Atlas Credentials (Cloud only)
MONGODB_USERNAME=your_mongodb_username
MONGODB_PASSWORD=your_mongodb_password
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/osint_eip?retryWrites=true&w=majority

# Vector Store
CHROMADB_PATH=./chroma_data

# Qwen Primary LLM Gateway
QWEN_API_KEY=your_qwen_api_key
QWEN_BASE_URL=https://api.example.com/v1
QWEN_MODEL=qwen3-14b
QWEN_TIMEOUT_SECONDS=7

# OpenRouter Secondary LLM Gateway
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-haiku
OPENROUTER_TIMEOUT_SECONDS=7

# Hybrid Clustering Signal Weights & Threshold
HYBRID_SEMANTIC_WEIGHT=0.55
HYBRID_ENTITY_WEIGHT=0.18
HYBRID_LOCATION_WEIGHT=0.12
HYBRID_TIME_WEIGHT=0.10
HYBRID_METADATA_WEIGHT=0.05
HYBRID_MATCH_THRESHOLD=0.62

# Ingestion / RSS
SOURCE_REQUEST_TIMEOUT_SECONDS=15
